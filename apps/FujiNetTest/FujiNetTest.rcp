#include "FujiNetTestRsc.h"

VERSION ID 1 "0.2"

ICONFAMILYEX
BEGIN
    BITMAP "icon.bmp" BPP 1
END

FORM ID MainForm AT (0 0 160 160)
NOFRAME
USABLE
BEGIN
    TITLE "FI Test"
    BUTTON "Ping" ID MainPingButton AT (20 140 50 AUTO)
    BUTTON "Fetch" ID MainFetchButton AT (90 140 50 AUTO)
END

ALERT ID RomIncompatibleAlert
ERROR
BEGIN
    TITLE "FI Test"
    MESSAGE "This app needs Palm OS 3.1 or later."
    BUTTONS "OK"
END
